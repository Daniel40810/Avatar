#version 430 core
// Flächennormalen (nicht normiert, also flächengewichtet) je Dreieck der gemischten Ruhelage.
layout(local_size_x = 64) in;
layout(std430, binding = 0) readonly buffer Rest { float rest[]; };
layout(std430, binding = 1) readonly buffer Idx { int idx[]; };
layout(std430, binding = 2) writeonly buffer TriN { float triN[]; };
uniform int uTris;
vec3 P(int i) { return vec3(rest[i * 3], rest[i * 3 + 1], rest[i * 3 + 2]); }
void main() {
    uint k = gl_GlobalInvocationID.x;
    if (k >= uint(uTris)) return;
    vec3 a = P(idx[k * 3u]), b = P(idx[k * 3u + 1u]), c = P(idx[k * 3u + 2u]);
    vec3 n = cross(b - a, c - a);
    triN[k * 3u] = n.x; triN[k * 3u + 1u] = n.y; triN[k * 3u + 2u] = n.z;
}
