    <path id="avatar.jogl">
        <pathelement location="lib/jogl-all.jar"/>
        <pathelement location="lib/gluegen-rt.jar"/>
    </path>

    <macrodef name="check-package">
        <attribute name="name"/>
        <attribute name="also" default="__keins__"/>
        <sequential>
            <delete dir="${build.dir}/check/@{name}" quiet="true"/>
            <mkdir dir="${build.dir}/check/@{name}"/>
            <javac srcdir="${src.dir}" destdir="${build.dir}/check/@{name}" includeantruntime="false"
                   release="21" encoding="UTF-8" failonerror="true" fork="false">
                <include name="com/dan/@{name}/**/*.java"/>
                <include name="com/dan/@{also}/**/*.java"/>
                <exclude name="com/dan/@{name}/demo/**"/>
                <exclude name="com/dan/@{also}/demo/**"/>
                <classpath refid="avatar.jogl"/>
            </javac>
            <!-- Demo darf zusätzlich FStyle.jar nutzen -->
            <javac srcdir="${src.dir}" destdir="${build.dir}/check/@{name}" includeantruntime="false"
                   release="21" encoding="UTF-8" failonerror="true" fork="false">
                <include name="com/dan/@{name}/demo/**/*.java"/>
                <classpath>
                    <path refid="avatar.jogl"/>
                    <pathelement location="lib/FStyle.jar"/>
                    <pathelement location="${build.dir}/check/@{name}"/>
                </classpath>
            </javac>
            <echo message="  com.dan.@{name}: grün"/>
        </sequential>
    </macrodef>

    <target name="db-startdaten" depends="compile" description="db/sql/06_startdaten.sql aus dem Java-Code erzeugen (Phase 14)">
        <java classname="com.dan.avatarstudio.DbStartdaten" fork="true" failonerror="true">
