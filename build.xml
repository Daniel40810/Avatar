    <property name="videoleben" value="docs/status/Status_Phase7.avi"/>
    <property name="statusumwelt" value="docs/status/Status_Phase8.png"/>
    <property name="statusportrait" value="docs/status/Status_Phase9.png"/>
    <property name="statuskleidung" value="docs/status/Status_Phase10.png"/>
    <property name="statusbewegung" value="docs/status/Status_Phase11.png"/>
    <property name="videobewegung" value="docs/status/Status_Phase11.avi"/>
    <property name="statusmengen" value="docs/status/Status_Phase12.png"/>
    <property name="videomengen" value="docs/status/Status_Phase12.avi"/>
